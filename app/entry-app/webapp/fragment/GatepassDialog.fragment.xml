<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form"
>
	<Dialog
		id="gatepassDialog"
		title="{dialog>/title}"
		contentWidth="70rem"
		verticalScrolling="true"
	>
		<content>
			<VBox class="sapUiSmallMargin">
				<form:SimpleForm
					editable="true"
					layout="ResponsiveGridLayout"
					labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
					emptySpanXL="0" emptySpanL="0" emptySpanM="0"
					columnsXL="1" columnsL="1" columnsM="1"
				>
					<core:Title text="{i18n>sectionPassDetails}"/>
					<Label text="{i18n>processType}" required="true"/>
					<Select
						id="processTypeSelect"
						selectedKey="{dialog>/processType}"
						change=".onProcessTypeChange"
						forceSelection="false"
						enabled="{= !${dialog>/isEditMode}}"
					>
						<items>
							<core:Item key="" text=""/>
							<core:Item key="Inward" text="{i18n>processTypeInward}"/>
							<core:Item key="Outward" text="{i18n>processTypeOutward}"/>
						</items>
					</Select>
					<Label text="{i18n>gatepassType}" required="true"/>
					<Select
						id="gatepassTypeSelect"
						selectedKey="{dialog>/gatepassType}"
						change=".onGatepassTypeChange"
						forceSelection="false"
						enabled="{= !${dialog>/isEditMode}}"
						items="{dialog>/gatepassTypeOptions}"
					>
						<items>
							<core:Item key="{dialog>key}" text="{dialog>text}"/>
						</items>
					</Select>

					<core:Title text="{dialog>/documentSectionTitle}" visible="{dialog>/showDocuments}"/>
					<Label text="{dialog>/documentInputLabel}" required="true" visible="{dialog>/showDocuments}"/>
					<HBox visible="{dialog>/showDocuments}">
						<MultiInput id="documentNumberInput" width="100%" submit=".onAddDocument" enabled="{= !${dialog>/isEditMode}}"/>
						<Button text="{i18n>add}" press=".onAddDocument" class="sapUiTinyMarginBegin" enabled="{= !${dialog>/isEditMode}}"/>
						<Button text="{i18n>go}" type="Emphasized" press=".onDocumentGo" class="sapUiTinyMarginBegin" enabled="{= !${dialog>/isEditMode}}"/>
					</HBox>

					<core:Title text="{i18n>sectionAdditionalDetails}"/>
					<Label
						text="{i18n>weighbridgeApplicable}"
						visible="{dialog>/weighbridgeEnabled}"
					/>
					<CheckBox
						id="weighbridgeCheckbox"
						selected="{dialog>/weighbridgeRequired}"
						visible="{dialog>/weighbridgeEnabled}"
					/>
					<Label
						text="{i18n>expectedReturnDate}"
						visible="{dialog>/showReturnDate}"
						required="{dialog>/returnDateRequired}"
					/>
					<DatePicker
						id="expectedReturnDatePicker"
						value="{dialog>/expectedReturnDate}"
						valueFormat="yyyy-MM-dd"
						displayFormat="dd/MM/yyyy"
						visible="{dialog>/showReturnDate}"
					/>
				</form:SimpleForm>

				<Panel class="sapUiSmallMarginTop" visible="{dialog>/showDocuments}">
					<Table
						id="documentItemsTable"
						noDataText="{i18n>noDocumentItems}"
					>
						<columns>
							<Column><header><Text text="{i18n>documentItemColumn}"/></header></Column>
						</columns>
					</Table>
				</Panel>

				<Panel headerText="{i18n>sectionLineItems}" class="sapUiSmallMarginTop" visible="{= !${dialog>/showDocuments}}">
					<headerToolbar>
						<Toolbar>
							<Title text="{i18n>sectionLineItems}"/>
							<ToolbarSpacer/>
							<Button icon="sap-icon://add" text="{i18n>addItem}" press=".onAddManualItem" type="Transparent"/>
						</Toolbar>
					</headerToolbar>
					<Table
						id="manualItemsTable"
						items="{dialog>/items}"
						noDataText="{i18n>noLineItems}"
					>
						<columns>
							<Column><header><Text text="{i18n>colMaterialCode}"/></header></Column>
							<Column><header><Text text="{i18n>colMaterialDesc}"/></header></Column>
							<Column><header><Text text="{i18n>colPartyName}"/></header></Column>
							<Column><header><Text text="{i18n>colReceivedQty}"/></header></Column>
							<Column><header><Text text="{i18n>colUom}"/></header></Column>
							<Column hAlign="Center" width="4rem"><header><Text text=""/></header></Column>
						</columns>
						<items>
							<ColumnListItem>
								<Input value="{dialog>materialCode}"/>
								<Input value="{dialog>materialDescription}"/>
								<Input value="{dialog>partyName}"/>
								<Input value="{dialog>receivedQuantity}" type="Number"/>
								<Input value="{dialog>unitOfMeasurement}" width="5rem"/>
								<Button icon="sap-icon://delete" type="Transparent" press=".onRemoveManualItem"/>
							</ColumnListItem>
						</items>
					</Table>
				</Panel>

				<form:SimpleForm
					id="carrierSection"
					editable="true"
					layout="ResponsiveGridLayout"
					labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
					emptySpanXL="0" emptySpanL="0" emptySpanM="0"
					columnsXL="1" columnsL="1" columnsM="1"
					visible="{dialog>/showCarrierSection}"
				>
					<core:Title text="{i18n>sectionCarrierDetails}"/>
					<Label text="{i18n>vehicleType}"/>
					<Select
						id="vehicleTypeSelect"
						selectedKey="{dialog>/vehicleType}"
						change=".onVehicleTypeChange"
						forceSelection="false"
						items="{dialog>/vehicleTypes}"
					>
						<items>
							<core:Item key="{dialog>ID}" text="{dialog>name}"/>
						</items>
					</Select>
					<Label text="{i18n>vehicleNumber}"/>
					<Input id="vehicleNumberInput" value="{dialog>/vehicleNumber}" enabled="{dialog>/carrierFields/vehicleNumber}"/>
					<Label text="{i18n>transporterName}"/>
					<Input id="transporterInput" value="{dialog>/transporter}" enabled="{dialog>/carrierFields/transporter}"/>
					<Label text="{i18n>driverName}"/>
					<Input id="driverNameInput" value="{dialog>/driverName}" enabled="{dialog>/carrierFields/driverName}"/>
					<Label text="{i18n>driverLicense}"/>
					<Input id="driverLicenseInput" value="{dialog>/driverLicense}" enabled="{dialog>/carrierFields/driverLicense}"/>
					<Label text="{i18n>driverContact}"/>
					<Input id="driverContactInput" value="{dialog>/driverContact}" enabled="{dialog>/carrierFields/driverContact}"/>
					<core:Title text=""/>
					<Label text="{i18n>entryGate}"/>
					<Select
						id="entryGateSelect"
						selectedKey="{dialog>/entryGate}"
						forceSelection="false"
						items="{dialog>/gates}"
					>
						<items>
							<core:Item key="{dialog>ID}" text="{dialog>name}"/>
						</items>
					</Select>
				</form:SimpleForm>
			</VBox>
		</content>
		<buttons>
			<Button
				text="{i18n>sendForApprovalBtn}"
				type="Success"
				press=".onSendForApprovalFromDialog"
				visible="{= ${dialog>/isEditMode} &amp;&amp; ${dialog>/approvalRequired}}"
			/>
			<Button
				text="{i18n>finaliseGatepass}"
				type="Success"
				press=".onFinaliseGatepassFromDialog"
				visible="{= ${dialog>/isEditMode} &amp;&amp; !${dialog>/approvalRequired}}"
			/>
			<Button
				text="{i18n>save}"
				type="Emphasized"
				press=".onSaveGatepass"
			/>
			<Button
				text="{i18n>close}"
				press=".onCloseGatepassDialog"
			/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
