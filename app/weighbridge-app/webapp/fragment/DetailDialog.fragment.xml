<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form"
>
	<Dialog
		id="detailDialog"
		title="{i18n>detailDialogTitle}"
		contentWidth="40rem"
		verticalScrolling="true"
	>
		<content>
			<VBox class="sapUiSmallMargin">
				<form:SimpleForm
					editable="false"
					layout="ResponsiveGridLayout"
					labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
					emptySpanXL="0" emptySpanL="0" emptySpanM="0"
					columnsXL="1" columnsL="1" columnsM="1"
				>
					<core:Title text="{i18n>sectionPassDetails}"/>
					<Label text="{i18n>passNumber}"/>
					<Text text="{detail>/passNumber}"/>
					<Label text="{i18n>createdAt}"/>
					<Text text="{detail>/createdAt}"/>
					<Label text="{i18n>createdBy}"/>
					<Text text="{detail>/createdBy}"/>
					<Label text="{i18n>processType}"/>
					<Text text="{detail>/processType}"/>
					<Label text="{i18n>gatepassType}"/>
					<Text text="{detail>/gatepassTypeFormatted}"/>
					<Label text="{i18n>documentNumber}"/>
					<Text text="{detail>/documents}"/>
					<Label text="{i18n>approvedAt}"/>
					<Text text="{detail>/approvedAt}"/>
					<Label text="{i18n>approvedBy}"/>
					<Text text="{detail>/approvedBy}"/>
				</form:SimpleForm>

				<form:SimpleForm
					editable="false"
					layout="ResponsiveGridLayout"
					labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
					emptySpanXL="0" emptySpanL="0" emptySpanM="0"
					columnsXL="1" columnsL="1" columnsM="1"
					visible="{detail>/isReturnable}"
				>
					<core:Title text="{i18n>sectionReturnDetails}"/>
					<Label text="{i18n>expectedReturnDate}"/>
					<Text text="{detail>/expectedReturnDate}"/>
				</form:SimpleForm>

				<Panel class="sapUiSmallMarginTop">
					<Table
						id="itemsTable"
						noDataText="{i18n>noItems}"
					>
						<columns>
							<Column><header><Text text="{i18n>itemColumn}"/></header></Column>
						</columns>
					</Table>
				</Panel>

				<form:SimpleForm
					editable="false"
					layout="ResponsiveGridLayout"
					labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
					emptySpanXL="0" emptySpanL="0" emptySpanM="0"
					columnsXL="1" columnsL="1" columnsM="1"
				>
					<core:Title text="{i18n>sectionCarrierDetails}"/>
					<Label text="{i18n>carrierType}"/>
					<Text text="{detail>/carrierType}"/>
					<Label text="{i18n>transporterName}"/>
					<Text text="{detail>/transporterName}"/>
					<Label text="{i18n>driverName}"/>
					<Text text="{detail>/driverName}"/>
					<Label text="{i18n>driverContact}"/>
					<Text text="{detail>/driverContact}"/>
					<Label text="{i18n>driverLicense}"/>
					<Text text="{detail>/driverLicense}"/>
					<Label text="{i18n>vehicleNumber}"/>
					<Text text="{detail>/vehicleNumber}"/>
				</form:SimpleForm>

				<form:SimpleForm
					editable="true"
					layout="ResponsiveGridLayout"
					labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
					emptySpanXL="0" emptySpanL="0" emptySpanM="0"
					columnsXL="1" columnsL="1" columnsM="1"
				>
					<core:Title text="{i18n>sectionWeighbridge}"/>
					<Label text="{i18n>entryWeight}"/>
					<Input
						id="dialogEntryWeight"
						value="{detail>/entryWeight}"
						type="Number"
						enabled="{= %{detail>/status} === 'EntryWeightPending'}"
					/>
					<Label text="{i18n>exitWeight}"/>
					<Input
						id="dialogExitWeight"
						value="{detail>/exitWeight}"
						type="Number"
						enabled="{= %{detail>/status} === 'ExitWeightPending'}"
					/>
					<Label text="{i18n>netWeight}"/>
					<Text text="{detail>/netWeight}"/>
				</form:SimpleForm>
			</VBox>
		</content>
		<buttons>
			<Button text="{i18n>saveWeights}" type="Emphasized" press=".onSaveWeightsFromDialog" visible="{= %{detail>/status} === 'EntryWeightPending' || %{detail>/status} === 'ExitWeightPending'}"/>
			<Button text="{i18n>finaliseEntryWeight}" type="Success" press=".onFinaliseEntryWeightFromDialog" visible="{= %{detail>/status} === 'EntryWeightPending'}"/>
			<Button text="{i18n>finaliseExitWeight}" type="Success" press=".onFinaliseExitWeightFromDialog" visible="{= %{detail>/status} === 'ExitWeightPending'}"/>
			<Button text="{i18n>close}" press=".onCloseDetailDialog"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
